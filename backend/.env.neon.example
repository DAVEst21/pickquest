# Ejemplo sin credenciales: sustituir por las URLs de Connect en Neon.
# DATABASE_URL usa el host con -pooler; DIRECT_URL usa el host directo.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=3&pool_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&connect_timeout=15
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://FRONTEND.vercel.app
NODE_ENV=production
