// Esquema oficial de base de datos PickQuest - SCS v2.3 / SRS v2.1

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemaFase {
  ELICITACION
  ATRIBUTOS_CALIDAD
  CODIGO_PRUEBAS
}

enum ModoRespuesta {
  OPCION_MULTIPLE
  DRAG_AND_DROP
  CODIGO
  COMPUESTO
}

enum CategoriaHabilidadSDLC {
  ELICITACION
  ATRIBUTOS_CALIDAD
  CODIGO_PRUEBAS
}

enum TipoObjeto {
  POCION
  PERGAMINO
  RELIQUIA
}

model Estudiante {
  id               Int    @id @default(autoincrement())
  email            String @unique
  passwordHash     String
  nombreAventurero String @unique
  avatar           String
  nivel            Int    @default(1)
  xpTotal          Int    @default(0)
  qpTotal          Int    @default(0)

  racha        RachaEstudio?
  intentos     IntentoReto[]
  ayudasUsadas UsoAyuda[]
  inventario   InventarioObjeto[]
  logros       LogroEstudiante[]
  habilidades  HabilidadSDLC[]

  @@map("estudiante")
}

model RachaEstudio {
  estudianteId    Int       @id
  diasActuales    Int       @default(0)
  diasRecord      Int       @default(0)
  // (Fase 1) Decimal, no Float: evita errores de redondeo binario en un
  // multiplicador que afecta directamente el QP otorgado.
  multiplicadorQP Decimal   @default(1.00) @db.Decimal(4, 2)
  ultimaActividad DateTime? @db.Date

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("racha_estudio")
}

model Fase {
  id         Int      @id @default(autoincrement())
  nombre     String
  tema       TemaFase
  dificultad String
  orden      Int      @unique

  retos          Reto[]
  contenidoApoyo ContenidoApoyo?

  @@map("fase")
}

model Reto {
  id                  Int           @id @default(autoincrement())
  faseId              Int
  orden               Int
  modo                ModoRespuesta
  contenido           Json // Estructura JSONB del ejercicio (enunciado, sub-ejercicios, opciones)
  criteriosAceptacion String?
  // (Fase 1) Fracción 0.0-1.0, no escala 0-100 (0.80 = 80%).
  calificacionMinima  Decimal       @db.Decimal(3, 2)
  recompensaXp        Int           @default(0)
  recompensaQp        Int           @default(0)

  fase         Fase          @relation(fields: [faseId], references: [id], onDelete: Cascade)
  intentos     IntentoReto[]
  ayudasUsadas UsoAyuda[]

  @@map("reto")
}

model ContenidoApoyo {
  id               Int    @id @default(autoincrement())
  faseId           Int    @unique
  contenidoTeorico String @db.Text
  ejemplos         String @db.Text
  glosario         String @db.Text

  fase Fase @relation(fields: [faseId], references: [id], onDelete: Cascade)

  @@map("contenido_apoyo")
}

model IntentoReto {
  id                    Int      @id @default(autoincrement())
  estudianteId          Int
  retoId                Int
  respuesta             Json // Almacena la solución enviada o el borrador del estudiante
  porcentaje            Int      @default(0)
  // (Fase 1) Entero 0-3, no Float.
  calificacionEstrellas Int      @default(0)
  xpGanado              Int      @default(0)
  qpGanado              Int      @default(0)
  aprobado              Boolean  @default(false)
  usoAyuda              Boolean  @default(false)
  creadoEn              DateTime @default(now())

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  // (Fase 1) Restrict, no Cascade: no se puede borrar un Reto que ya tiene
  // intentos (perdería el historial de progreso del estudiante).
  reto       Reto       @relation(fields: [retoId], references: [id], onDelete: Restrict)
  ayudas     UsoAyuda[]

  // (Fase 1) Restaura el índice perdido en el DROP/CREATE de la sync SCS:
  // es la consulta que se dispara en cada GET /fases y en cada envío de intento.
  @@index([estudianteId, retoId])
  @@map("intento_reto")
}

model UsoAyuda {
  id           Int      @id @default(autoincrement())
  estudianteId Int
  retoId       Int
  objetoId     Int
  intentoId    Int?
  creadoEn     DateTime @default(now())

  estudiante Estudiante   @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  // (Fase 1) Restrict, no Cascade: no se puede borrar un Reto ni un Objeto
  // que ya tienen ayudas registradas.
  reto       Reto         @relation(fields: [retoId], references: [id], onDelete: Restrict)
  objeto     Objeto       @relation(fields: [objetoId], references: [id], onDelete: Restrict)
  intento    IntentoReto? @relation(fields: [intentoId], references: [id], onDelete: SetNull)

  @@map("uso_ayuda")
}

model Objeto {
  id      Int        @id @default(autoincrement())
  nombre  String     @unique
  tipo    TipoObjeto
  costoQP Int
  efecto  String
  rareza  String

  inventarios  InventarioObjeto[]
  ayudasUsadas UsoAyuda[]

  @@map("objeto")
}

model InventarioObjeto {
  estudianteId Int
  objetoId     Int
  cantidad     Int     @default(1)
  equipado     Boolean @default(false)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  // (Fase 1) Restrict, no Cascade: no se puede borrar un Objeto que algún
  // estudiante ya tiene en su inventario.
  objeto     Objeto     @relation(fields: [objetoId], references: [id], onDelete: Restrict)

  @@id([estudianteId, objetoId])
  @@map("inventario_objeto")
}

model Logro {
  id                  Int    @id @default(autoincrement())
  nombre              String @unique
  condicionDesbloqueo String

  estudiantes LogroEstudiante[]

  @@map("logro")
}

model LogroEstudiante {
  estudianteId  Int
  logroId       Int
  fechaObtenido DateTime @default(now()) @db.Date

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  logro      Logro      @relation(fields: [logroId], references: [id], onDelete: Cascade)

  @@id([estudianteId, logroId])
  @@map("logro_estudiante")
}

model HabilidadSDLC {
  id             Int                    @id @default(autoincrement())
  estudianteId   Int
  categoria      CategoriaHabilidadSDLC
  nivelAlcanzado Int                    @default(1)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, categoria])
  @@map("habilidad_sdlc")
}
